# Bu dosyayı ".env" adıyla kopyalayın (ya da `make init` / baslat.cmd bunu sizin yerinize yapar).
# Burada YALNIZCA sistem düzeyi ayarlar durur. Kullanıcıların servis anahtarları (Anthropic, ElevenLabs,
# Kling, HeyGen) buraya yazılmaz: her kullanıcı kendi anahtarını uygulamadaki kurulum sihirbazından girer
# ve anahtarlar veritabanında ENCRYPTION_KEY ile şifreli saklanır.

# --- ZORUNLU (make init üretir) ------------------------------------------------------------
# Oturum ve bağlantı imzaları. En az 24 karakter, rastgele.
APP_SECRET=
# Kullanıcı servis anahtarlarını şifreleyen ana anahtar (Fernet). KAYBEDERSENİZ kayıtlı anahtarlar
# çözülemez; .env dosyasının yedeğini alın. Değiştirirseniz kullanıcılar anahtarlarını yeniden girer.
ENCRYPTION_KEY=

# --- İSTEĞE BAĞLI ------------------------------------------------------------------------
# Veritabanı. Boşsa SQLite (data/studyo.db). PostgreSQL örneği:
# DATABASE_URL=postgresql://studyo:sifre@localhost:5432/studyo
DATABASE_URL=

# Uygulamanın dışarıdan erişilen HTTPS adresi. Ayarlanınca: çerezler Secure olur, CORS ve Host
# denetimi bu alan adına göre yapılır, e-posta/davet bağlantıları bu adresle üretilir ve sağlayıcı
# webhook'ları (yoklama yerine geri çağrı) etkinleşir. Yerel kullanımda boş bırakın.
# PUBLIC_BASE_URL=https://studyo.example.com
PUBLIC_BASE_URL=
# Ek Host adları (virgülle)
ALLOWED_HOSTS=

# S3 uyumlu dosya deposu (AWS S3 / Cloudflare R2 / MinIO). Boşsa yerel disk (storage/).
# R2 için: S3_ENDPOINT=https://<hesap>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# E-posta (şifre sıfırlama, doğrulama, davet, bildirim). Boşsa yönetici tek kullanımlık bağlantı üretir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# --- DAVRANIŞ ----------------------------------------------------------------------------
# true: Anthropic anahtarı olmayan kullanıcılar sahte yönetmenle deneyebilir (yönetici panelinden de açılır)
DEMO_MODE=false
# true: açılışta demo kullanıcı + örnek bölüm oluşturulur (şifre data/demo_sifre.txt). Sunucuda false yapın.
SEED_DEMO=true
# DEMO_EMAIL=demo@studyo.local
# DEMO_PASSWORD=
# deneme (mock) işlerinin yapay bekleme süresi (sn)
MOCK_DELAY=0.4
SESSION_DAYS=14

# Konumlar (varsayılan: proje kökü)
# DATA_DIR=./data
# STORAGE_DIR=./storage
